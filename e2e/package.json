{
  "name": "brainbytes-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for BrainBytes application",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles --forceExit --verbose",
    "test:headless": "jest --runInBand --detectOpenHandles --forceExit --verbose",
    "lint": "eslint --ext .js tests/",
    "lint:fix": "eslint --ext .js tests/ --fix",
    "format": "prettier --write \"tests/**/*.{js,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"tests/**/*.{js,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "axios": "^1.6.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^6.3.3"
  }
}
