{
  "name": "brainbytes-api",
  "version": "1.0.0",
  "description": "Backend API for BrainBytes learning platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test jest --forceExit --detectOpenHandles",
    "test:windows": "set NODE_ENV=test && jest --forceExit --detectOpenHandles",
    "test:unix": "NODE_ENV=test jest --forceExit --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --ext .js,.ts . --fix",
    "format": "prettier --write \"**/*.{js,ts,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,ts,json}\" --ignore-path .gitignore"
  },
  "dependencies": {
    "@huggingface/inference": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.5.3",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "forceExit": true,
    "detectOpenHandles": true,
    "verbose": true
  },
  "keywords": [
    "education",
    "ai",
    "learning",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT"
}
